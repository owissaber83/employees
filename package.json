{
  "dependencies": {
    "firebase": "^12.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.10.0"
  },
  "scripts": {
    "deploy": "firebase deploy --only hosting",
    "test:rules": "firebase emulators:exec --only database --project demo-gbr-rules \"node tests/rules.test.mjs\"",
    "test:calc": "node tests/calc.test.mjs",
    "test:pdf": "node tests/pdfeditor.test.mjs",
    "test:ai": "node tests/aiinvoice.test.mjs",
    "test:pdf:e2e": "node tests/pdfeditor.e2e.mjs",
    "test:ai:e2e": "node tests/aiinvoice.e2e.mjs",
    "test:proxy": "node tests/aiproxy.test.mjs",
    "lint": "eslint . --quiet",
    "lint:all": "eslint .",
    "lint:globals": "node scripts/gen-eslint-globals.mjs",
    "test:ai:page": "node tests/aiinvoice-page.e2e.mjs",
    "test:char": "node tests/characterization/chartOfAccounts.test.mjs",
    "test:char:date": "node tests/characterization/date-behavior.test.mjs",
    "test:domain": "npm run test:char && npm run test:char:date && npm run test:repo",
    "test:repo": "node tests/repositories/chartOfAccounts.test.mjs",
    "test:gm": "node tests/golden-master/journal.test.mjs",
    "test:gm:posting": "node tests/golden-master/posting-integrity.test.mjs",
    "test:gm:all": "npm run test:gm && npm run test:gm:posting"
  }
}
