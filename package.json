{
  "dependencies": {
    "firebase": "^12.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.10.0"
  },
  "scripts": {
    "deploy": "firebase deploy --only hosting",
